{
    "name": "moffhub/mps-spec",
    "description": "Moffhub Payment Standard - Interfaces, DTOs, Enums, and Event Schemas",
    "type": "library",
    "license": "MIT",
    "keywords": ["payments", "mps", "moffhub", "connector", "specification"],
    "homepage": "https://github.com/Moffhub-Solutions/mps-spec",
    "support": {
        "issues": "https://github.com/Moffhub-Solutions/mps-spec/issues",
        "source": "https://github.com/Moffhub-Solutions/mps-spec"
    },
    "authors": [
        { "name": "Moffhub", "homepage": "https://moffhub.com" }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Moffhub\\MpsSpec\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moffhub\\MpsSpec\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable"
}
